# Terapimap ortam değişkenleri.
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# Gerçek değerleri bu dosyaya YAZMAYIN; bu dosya Git'e girer.
# Ayrıntılar: docs/DEVELOPMENT.md

# --- Supabase (zorunlu) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca server tarafı; RLS'i atlar. Asla NEXT_PUBLIC_ önekiyle tanımlamayın.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin paneli (zorunlu, yalnızca server) ---
ADMIN_PASSWORD=

# --- E-posta / Gmail SMTP (zorunlu, yalnızca server) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Site (opsiyonel; boşsa https://terapimap.com veya http://localhost:3000 varsayılır) ---
NEXT_PUBLIC_SITE_URL=

# --- Analitik (opsiyonel; çerez onayıyla yüklenir) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Diğer (opsiyonel) ---
# Boşsa WhatsApp butonu gösterilmez.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Google Maps Embed API anahtarı; Cloud Console'da HTTP referrer kısıtlaması olmalı.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Lansman kampanyası bitişi (ISO tarih). Boşsa 2027-01-01T00:00:00+03:00; "off" kapatır.
CAMPAIGN_FEATURED_UNTIL=
